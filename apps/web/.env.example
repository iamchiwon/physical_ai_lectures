NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
# Canonical production origin, including in preview builds. No path/query/fragment.
NEXT_PUBLIC_SITE_URL=https://physical-ai-learning-web.pages.dev
# Cloudflare Pages previews receive noindex. Set this if production uses another branch.
SEO_PRODUCTION_BRANCH=main
# Set SEO_INDEXABLE=false for non-production mirrors.
# Optional public ownership tokens (content value only, not an entire meta tag).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
