{
  "name": "@physical-ai/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --var ALLOWED_ORIGINS:http://localhost:3000",
    "check": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply physical-ai-learning --local",
    "db:migrate:remote": "wrangler d1 migrations apply physical-ai-learning --remote"
  },
  "dependencies": {
    "@physical-ai/shared": "*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.10.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251014.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "wrangler": "^4.45.0"
  }
}
