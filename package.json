{
  "name": "physical-ai-learning-platform",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c blue,cyan \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace @physical-ai/web",
    "dev:api": "npm run dev --workspace @physical-ai/api",
    "build": "npm run build:shared && npm run build:web && npm run build:api && npm run check:publication && npm run check:visuals",
    "build:shared": "npm run build --workspace @physical-ai/shared",
    "build:web": "npm run build --workspace @physical-ai/web",
    "build:api": "npm run build --workspace @physical-ai/api",
    "check": "npm run check --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test:tutor": "node --test tests/tutor.test.mjs",
    "deploy:web": "wrangler pages deploy apps/web/out --project-name physical-ai-learning-web",
    "deploy:api": "npm run deploy --workspace @physical-ai/api",
    "test:catalog": "node --test tests/catalog.test.mjs",
    "prebuild": "npm run prepare:authored && npm run test:catalog",
    "test:home": "node --test tests/home.test.mjs",
    "test:curriculum": "node --test tests/curriculum.test.mjs",
    "test:study": "node --test tests/study.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "prepare:authored": "node scripts/prepare-authored.mjs",
    "pretest": "npm run prepare:authored && npm run prepare:projects",
    "precheck": "npm run prepare:authored",
    "prepare:projects": "node scripts/prepare-projects.mjs",
    "check:publication": "node scripts/check-publication.mjs",
    "check:visuals": "node scripts/check-visuals.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.49.0"
  },
  "overrides": {
    "katex": "^0.19.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
